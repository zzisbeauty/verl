FROM stdcuda:12.4.1  
  
# 设置工作目录  
WORKDIR /workspace  
  
# 配置 pip 镜像源  
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple  
  
# 安装系统依赖  
# RUN apt-get update && apt-get install -y --no-install-recommends \  
#     git \  
#     wget \  
#     curl \  
#     build-essential \  
#     && rm -rf /var/lib/apt/lists/* \  
#     && pip cache purge  
  
# 安装核心依赖 - 基于项目稳定版本  
RUN pip install --upgrade pip setuptools packaging  
  
# 安装 PyTorch 生态系统（基于项目版本）  
# RUN pip install torch==2.6.0 torchvision==0.21.0 torchaudio==2.6.0 --index-url https://download.pytorch.org/whl/cu124  
# 不安装上述 torch 2.6， 就是用镜像自带的 torch 2.4
  
# 安装 FlashAttention  
RUN pip install flash-attn==2.7.3 --no-build-isolation  
  
# 安装 NVIDIA 优化库  
RUN pip install nvidia-cudnn-cu12==9.8.0.87  
  
# 安装 TransformerEngine  
RUN pip install transformer-engine==2.3  
  
# 安装 Megatron-LM  
RUN pip install git+https://github.com/NVIDIA/Megatron-LM.git@core_v0.12.2  
  
# 安装 vLLM  
RUN pip install vllm==0.8.5.post1
  
# 安装 SGLang  
RUN pip install sglang==0.4.6.post5  
  
# 安装 verl 核心依赖  
RUN pip install \  
    accelerate \  
    codetiming \  
    datasets \  
    dill \  
    hydra-core \  
    liger-kernel \  
    numpy \  
    pandas \  
    peft \  
    "pyarrow>=15.0.0" \  
    pylatexenc \  
    "ray[data,train,tune,serve]" \  
    torchdata \  
    transformers \  
    wandb \  
    orjson \  
    pybind11 \  
    "tensordict<0.6" \  
    hf_transfer \  
    hf_xet  
  
# 设置环境变量  
ENV PYTHONUNBUFFERED=1  
ENV TRANSFORMERS_CACHE=/root/.cache/huggingface  
ENV HF_HOME=/root/.cache/huggingface  
ENV MODELSCOPE_CACHE=/root/.cache/modelscope  
ENV VLLM_USE_V1=1  
  
# 设置默认命令  
CMD ["/bin/bash"]